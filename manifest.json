{
  "manifest_version": 3,
  "name": "Markdown Reader",
  "version": "0.1.0",
  "description": "增强 Git 平台上的 Markdown 渲染效果，达到 GitHub 品质",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "file:///*"],
      "js": ["content.js"],
      "css": ["themes/github-light.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["themes/*", "katex/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
